[Unit]
Description=HDCAM archive from existing viewer
Wants=hdcam.service
After=hdcam.service
StartLimitIntervalSec=0

[Service]
Type=simple
ExecStart=%h/.local/bin/hdcam record --source http://127.0.0.1:8080 --username hdcam --token-file %h/.config/hdcam/viewer.token --archive-dir %h/.local/share/hdcam/recordings --audio --duration 0 --max-bytes 536870912 --keep-segments 100
Restart=always
RestartSec=5
TimeoutStopSec=10
KillMode=control-group
UMask=0077
NoNewPrivileges=true

[Install]
WantedBy=default.target
